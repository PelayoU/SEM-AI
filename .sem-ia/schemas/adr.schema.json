{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/adr",
  "title": "SEM-IA ADR Node",
  "allOf": [
    { "$ref": "node-base.schema.json" },
    {
      "properties": {
        "type": { "const": "adr" },
        "status": {
          "type": "string",
          "enum": ["proposed", "accepted", "superseded", "deprecated"]
        },
        "dimensions-affected": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Dimensiones que afecta esta decisión"
        },
        "related-features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Features afectadas por esta decisión"
        },
        "supersedes": {
          "type": ["string", "null"],
          "description": "ADR anterior que este reemplaza"
        },
        "superseded-by": {
          "type": ["string", "null"],
          "description": "ADR posterior que reemplaza a este"
        }
      },
      "required": ["dimensions-affected"]
    }
  ]
}
