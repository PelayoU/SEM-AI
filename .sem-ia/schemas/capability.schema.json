{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/capability",
  "title": "SEM-IA Capability Node",
  "allOf": [
    { "$ref": "node-base.schema.json" },
    {
      "properties": {
        "type": { "const": "capability" },
        "parent": {
          "type": "string",
          "pattern": "^goal-",
          "description": "Goal padre"
        },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Features que materializan esta capability"
        }
      },
      "required": ["parent"]
    }
  ]
}
