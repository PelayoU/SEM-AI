{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/working-agreement",
  "title": "SEM-IA Working Agreement Node",
  "type": "object",
  "properties": {
    "type": { "const": "working-agreement" },
    "id": {
      "type": "string",
      "pattern": "^wa-"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "cancelled"]
    },
    "phase": {
      "type": "string",
      "enum": ["discovery", "implementation", "verification", "arbitration"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "related-feature": {
      "type": ["string", "null"]
    },
    "related-capability": {
      "type": ["string", "null"]
    },
    "active-role": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "scope-allowed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope-forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dimensions-affected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verifiers-required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "closure-criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "required": [
    "type", "id", "created", "status", "phase",
    "objective", "active-role", "participants",
    "closure-criteria"
  ]
}
