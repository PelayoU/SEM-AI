{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/learning",
  "title": "SEM-IA Learning Node",
  "allOf": [
    { "$ref": "node-base.schema.json" },
    {
      "properties": {
        "type": { "const": "learning" },
        "origin": {
          "type": "string",
          "description": "Contexto en el que se descubrió el aprendizaje"
        },
        "dimensions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dimensiones relevantes para este aprendizaje"
        }
      },
      "required": ["origin"]
    }
  ]
}
