{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/node-base",
  "title": "SEM-IA Node Base",
  "description": "Campos comunes a todos los nodos del grafo SEM-IA",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Tipo de nodo del grafo"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Identificador único del nodo"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Título legible del nodo"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "in-progress", "done", "archived"],
      "description": "Estado del nodo"
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Fecha de creación (YYYY-MM-DD)"
    },
    "author": {
      "type": "string",
      "description": "Quién creó el nodo (rol o humano)"
    }
  },
  "required": ["type", "id", "title", "status", "created", "author"]
}
