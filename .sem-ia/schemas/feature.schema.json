{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sem-ia.dev/schemas/feature",
  "title": "SEM-IA Feature Node",
  "allOf": [
    { "$ref": "node-base.schema.json" },
    {
      "properties": {
        "type": { "const": "feature" },
        "parent": {
          "type": "string",
          "pattern": "^cap-",
          "description": "Capability padre"
        },
        "dimensions-affected": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Dimensiones del producto holístico que toca esta feature"
        },
        "depends-on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Features de las que depende"
        },
        "also-relates-to": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nodos relacionados (enlaces cruzados)"
        },
        "related-adrs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ADRs que aplican a esta feature"
        },
        "github-issue": {
          "type": ["integer", "null"],
          "description": "Número del issue de GitHub asociado"
        }
      },
      "required": ["parent", "dimensions-affected"]
    }
  ]
}
